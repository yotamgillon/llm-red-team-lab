# Copy to .env (never commit .env). All values optional: with no key the target runs in MOCK mode.
MOCK_MODE=true
SECURE_MODE=false
LAB_ENDPOINTS=true
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Secure mode only: token that confirms pending refunds and unlocks internal KB docs.
# Leave empty to get a random per-process token (nobody, including the model, can know it).
# STAFF_TOKEN=
