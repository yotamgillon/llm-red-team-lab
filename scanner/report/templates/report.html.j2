<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
<title>LLM Red Team Report</title>
<style>
  :root { --bg:#fff; --fg:#1b1f24; --muted:#59636e; --line:#d0d7de; --panel:#f6f8fa;
          --critical:#8e1b1b; --high:#d1242f; --medium:#bc6c00; --low:#1f6feb; --info:#6e7781; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#0d1117; --fg:#e6edf3; --muted:#9198a1; --line:#30363d; --panel:#161b22;
            --critical:#ff7b72; --high:#f85149; --medium:#d29922; --low:#58a6ff; --info:#9198a1; } }
  body { margin:0 auto; max-width:60rem; padding:1rem; background:var(--bg); color:var(--fg);
         font:15px/1.5 system-ui, sans-serif; }
  h1, h2, h3 { line-height:1.25; }
  table { border-collapse:collapse; width:100%; margin:.5rem 0 1.5rem; }
  th, td { border:1px solid var(--line); padding:.35rem .6rem; text-align:left; vertical-align:top; }
  th { background:var(--panel); }
  pre { background:var(--panel); border:1px solid var(--line); padding:.6rem; overflow-x:auto;
        white-space:pre-wrap; word-break:break-word; }
  .meta { color:var(--muted); }
  .sev { font-weight:600; }
  .sev-critical { color:var(--critical); } .sev-high { color:var(--high); }
  .sev-medium { color:var(--medium); } .sev-low { color:var(--low); }
  .sev-info { color:var(--info); }
  svg text { fill:var(--fg); font:13px system-ui, sans-serif; }
  .bar-critical { fill:var(--critical); } .bar-high { fill:var(--high); }
  .bar-medium { fill:var(--medium); } .bar-low { fill:var(--low); } .bar-info { fill:var(--info); }
</style>
</head>
<body>
<h1>LLM Red Team Report</h1>
<p class="meta">
  Target: {{ report.target }} &middot; Started: {{ report.started_at }} &middot;
  Mode: {% for k, v in report.mode.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% else %}n/a{% endfor %}
</p>
<p><strong>{{ summary.vulnerable }}</strong> vulnerable of {{ summary.total }} attacks.</p>

<h2>Severity chart (vulnerable attacks)</h2>
<svg role="img" aria-label="Vulnerable attacks by severity" width="{{ chart_width }}" height="{{ chart_height }}" viewBox="0 0 {{ chart_width }} {{ chart_height }}">
{% for row in chart_rows %}
  <text x="0" y="{{ row.y + 16 }}">{{ row.severity }}</text>
  <rect class="bar-{{ row.severity }}" x="{{ label_width }}" y="{{ row.y }}" width="{{ row.width }}" height="{{ bar_height }}" rx="3"></rect>
  <text x="{{ label_width + row.width + 8 }}" y="{{ row.y + 16 }}">{{ row.count }}</text>
{% endfor %}
</svg>

<h2>Category summary</h2>
<table>
  <thead><tr><th>Category</th><th>Attacks</th><th>Vulnerable</th></tr></thead>
  <tbody>
{% for cat, c in summary.by_category.items() %}
    <tr><td>{{ cat }}</td><td>{{ c.total }}</td><td>{{ c.vulnerable }}</td></tr>
{% endfor %}
  </tbody>
</table>

<h2>Findings</h2>
{% for r in findings %}
<h3>{{ r.attack_id }} &ndash; {{ r.title }}</h3>
<p><span class="sev sev-{{ r.severity }}">{{ r.severity }}</span> &middot; payload: {{ r.payload or "-" }} &middot; confidence: {{ "%.2f"|format(r.confidence or 0) }}</p>
<p><strong>Remediation:</strong> {{ r.remediation or "-" }}</p>
<pre>{{ r.evidence }}</pre>
{% else %}
<p>No vulnerable attacks.</p>
{% endfor %}

<h2>Other results</h2>
{% if others %}
<table>
  <thead><tr><th>Attack</th><th>Severity</th><th>Status</th><th>Note</th></tr></thead>
  <tbody>
{% for r in others %}
    <tr><td>{{ r.attack_id }}</td><td>{{ r.severity }}</td><td>{{ r.status }}</td><td>{{ r.error or r.evidence or "" }}</td></tr>
{% endfor %}
  </tbody>
</table>
{% else %}
<p>None.</p>
{% endif %}
</body>
</html>
